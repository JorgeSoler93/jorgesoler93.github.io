# --- Datos ---
ARMARIO_DATA_DIR=./data              # fotos originales y recortadas
# SQLite local (por defecto) ...
ARMARIO_DB=./data/armario.db
# ... o tu Supabase del mini PC (si se definen, tienen prioridad):
# SUPABASE_URL=http://localhost:8000
# SUPABASE_SERVICE_KEY=eyJ...

# --- IA ---
ANTHROPIC_API_KEY=sk-ant-...
ARMARIO_MODEL=claude-sonnet-5-5

# --- Imagen generativa (opcional: limpia la foto de la prenda con IA) ---
# OPENAI_API_KEY=sk-...
# ARMARIO_IMAGE_MODEL=gpt-image-1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_IDS=11111111        # tu user id (coma para varios)

# --- Web ---
ARMARIO_API_TOKEN=                   # vacío = sin token (ya estás detrás de Tailscale)
